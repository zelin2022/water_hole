# Copy to a private environment file outside the repository for future deployment.
# Startup is localhost-only and submissions fail closed until all required values exist.
PORT=3210
PUBLIC_ORIGIN=
TURNSTILE_HOSTNAME=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FEEDBACK_DB=feedback-server/data/feedback.sqlite
# Set to 0 for the emergency submission switch.
SUBMISSIONS_ENABLED=0
# Set only when Cloudflare Tunnel exclusively connects to this loopback service.
TRUST_PROXY=
# Optional HTTPS browser game origins, comma-separated. Electron's null origin is included.
ALLOWED_WEB_ORIGINS=

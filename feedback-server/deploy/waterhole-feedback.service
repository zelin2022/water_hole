[Unit]
Description=Water Hole private feedback receiver
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=waterhole-feedback
Group=waterhole-feedback
Slice=waterhole.slice
WorkingDirectory=/opt/waterhole-feedback/current
EnvironmentFile=/etc/waterhole-feedback/receiver.env
ExecStart=/opt/waterhole-feedback/node/bin/node --max-old-space-size=64 /opt/waterhole-feedback/current/feedback-server/start.mjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
StateDirectory=waterhole-feedback
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
TasksMax=64
LimitNOFILE=256
Nice=10
OOMScoreAdjust=500
LogNamespace=waterhole
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target

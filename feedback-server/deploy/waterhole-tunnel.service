[Unit]
Description=Water Hole outbound Cloudflare Tunnel
Wants=network-online.target waterhole-feedback.service
After=network-online.target waterhole-feedback.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=waterhole-tunnel
Group=waterhole-tunnel
Slice=waterhole.slice
LoadCredential=tunnel-token:/etc/waterhole-feedback/tunnel-token
Environment=GOMEMLIMIT=96MiB GOMAXPROCS=1
ExecStart=/opt/waterhole-feedback/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:3211 --loglevel warn run --token-file %d/tunnel-token
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryHigh=96M
MemoryMax=128M
MemorySwapMax=0
TasksMax=128
LimitNOFILE=256
Nice=10
OOMScoreAdjust=500
LogNamespace=waterhole
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60
LogRateLimitBurst=30

[Install]
WantedBy=multi-user.target

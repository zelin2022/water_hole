{
  "name": "water-hole",
  "version": "0.0.1",
  "private": true,
  "description": "A small excavation and water collection game prototype.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
